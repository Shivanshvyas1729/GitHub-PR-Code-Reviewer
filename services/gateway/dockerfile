# ==========================================
# Build & Dependency Installation
# ==========================================
FROM python:3.11-slim

WORKDIR /app

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install system dependencies if your Python packages need compilation
# (uncomment if you add packages like cryptography, pydantic-core binaries, etc.)
# RUN apt-get update && apt-get install -y --no-install-recommends gcc build-essential && rm -rf /var/lib/apt/lists/*

# Copy only requirements first to leverage Docker layer caching
COPY services/gateway/requirements.txt .

# Install dependencies into a local user directory path
RUN pip install --no-cache-dir --user -r requirements.txt

COPY services/gateway/ .

# Run Uvicorn tuned for a production container environment
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
